	partition Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2010, 1, 1 ), EOMONTH ( MAX ( fact_cpi[date] ), 0 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month", FORMAT ( [Date], "MMM" ),
				    "Month No", MONTH ( [Date] ),
				    "Year Month", FORMAT ( [Date], "YYYY-MM" )
				)

	annotation PBI_Id = 0071266d17e54fb3b2a62f808754e2b0

