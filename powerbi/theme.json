{
  "name": "Malaysia Inflation",
  "dataColors": [
    "#0369A1",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#6250D6",
    "#E34948"
  ],
  "foreground": "#0F172A",
  "foregroundNeutralSecondary": "#475569",
  "foregroundNeutralTertiary": "#64748B",
  "background": "#FFFFFF",
  "backgroundLight": "#F8FAFC",
  "backgroundNeutral": "#E2E8F0",
  "tableAccent": "#0369A1",
  "good": "#1BAF7A",
  "neutral": "#EDA100",
  "bad": "#E34948",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 16,
            "right": 16
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "position": "Top",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F1F5F9"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#0369A1"
              }
            }
          }
        ],
        "text": [
          {
            "fontColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 11
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "roundEdge": 8
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "textSize": 11
          }
        ]
      }
    },
    "card": {
      "*": {
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#475569"
              }
            },
            "fontSize": 11
          }
        ]
      }
    }
  }
}